{
  "name": "roleplay-companion",
  "version": "1.0.0",
  "description": "Roleplay Companion — Desktop app per gestione campagne e personaggi D&D",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "lint": "eslint src/",
    "test": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "electron-log": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.2",
    "vitest": "^3.0.9",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.roleplay.companion",
    "productName": "Roleplay Companion",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**",
      "dist/**"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
